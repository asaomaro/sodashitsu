{
  "name": "sodashitsu-workspace",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "node scripts/run-quiet.mjs \"pnpm -r --filter=./packages/* run build\"",
    "typecheck": "node scripts/run-quiet.mjs \"pnpm -r --filter=./packages/* run typecheck && tsc -p scripts/tsconfig.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "smoke": "node --enable-source-maps packages/server/dist/smoke.js",
    "build:signin": "node scripts/remote-desktop/build-signin-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "rolldown": "1.2.9",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "werift@0.25.2": "patches/werift@0.25.2.patch"
    }
  }
}
