#!/bin/sh
# 開発用の soda。リポジトリの packages/server/dist を直接実行する（先に pnpm build しておく）。
self=$0
while [ -h "$self" ]; do
  dir=$(cd "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case $self in /*) ;; *) self=$dir/$self ;; esac
done
here=$(cd "$(dirname "$self")" && pwd)
exec node --enable-source-maps "$here/../packages/server/dist/main.js" "$@"
