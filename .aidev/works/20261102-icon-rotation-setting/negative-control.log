try{const page=await browser.newPage({viewport:{width:1000,height:1000}});await page.route('**/*',r=>r.abort());await page.setContent((await readFile(base+'settings.html','utf8')).replace(/<script[^>]*src=[^>]*><\/script>/g,''));await page.addStyleTag({content:await readFile(base+'style.css','utf8')});await page.evaluate(()=>{window.assistant={read:async()=>({enabled:true,mode:'character',characterId:'captain-male',characterSize:192,voiceProvider:'system'}),characters:async()=>({characters:[{id:'plugin:yukkuri-work/guide',packId:'yukkuri-work',name:'案内役',uri:'data:image/png;base64,'}]}),displays:async()=>[],onVoice:()=>()=>{},voiceState:async()=>({revision:0,message:''})};});await page.addScriptTag({content:await readFile(base+'settings.js','utf8')});await page.waitForFunction(()=>document.querySelector('#character-pack-list option')?.textContent==='フォルダから取り込んだキャラクター');const rotation=page.locator('#icon-rotation-setting');if(await rotation.isVisible())throw Error('rotation shown for male captain');await page.locator('#characterId').selectOption('sodashitsu-icon');if(!await rotation.isVisible())throw Error('rotation hidden for icon');await page.locator('#iconRotation').uncheck();await page.locator('#characterId').selectOption('captain-female');if(await rotation.isVisible())throw Error('rotation shown for female captain');await page.locator('#characterId').selectOption('plugin:yukkuri-work/guide');if(await rotation.isVisible())throw Error('rotation shown for imported character');await page.locator('#characterId').selectOption('sodashitsu-icon');if(!await rotation.isVisible()||await page.locator('#iconRotation').isChecked())throw Error('rotation value changed');console.log(JSON.stringify({initiallyHidden:true,onlyIconVisible:true,selectionChangesImmediate:true,rotationValueRetained:true}));}finally{await browser.close();}
