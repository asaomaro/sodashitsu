{
  "name": "@sodashitsu/desktop-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "start": "electron .",
    "verify:ui": "node scripts/verify-ui.mjs",
    "build:host": "tsc -b && node scripts/build-host.mjs"
  },
  "dependencies": {
    "@sodashitsu/protocol": "workspace:*",
    "ws": "^8.21.3",
    "zod": "^4.6.5",
    "@sodashitsu/client-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "45.1.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1",
    "@playwright/test": "^1.63.0",
    "@types/ws": "^8.5.13"
  },
  "productName": "Sodashitsu Assistant",
  "description": "Sodashitsu desktop assistant native host"
}
