{
  "name": "@sodashitsu/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pinnedTls": {
      "types": "./dist/net/pinnedTls.d.ts",
      "default": "./dist/net/pinnedTls.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sodashitsu/client-core": "workspace:*",
    "@sodashitsu/protocol": "workspace:*",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@sodashitsu/server": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
